parameters:
	phpVersion:
		min: 80100	# PHP 8.1
		max: 80599	# PHP 8.5 (latest released branch)
	level: 5	# TODO: Increase to 10 https://phpstan.org/user-guide/rule-levels
	fileExtensions:
		- php
		- phtml
	paths:
		- ../FreshRSS
		- .
	excludePaths:
		analyse:
			- ../FreshRSS
			# Drives the entrypoint against those same stubs, so its symbols only exist at test
			# runtime. Analysing it would resolve them to the real framework classes and report
			# differences that are the point of the double, not defects. It is still scanned.
			- tests/ExtensionEntrypointTest.php
			- tests/LayoutReconciliationTest.php
		analyseAndScan:
			- .git/*?
			- node_modules/*?
			- vendor/
			# The unit-test stubs redeclare framework classes. Scanning them makes PHPStan resolve
			# the entrypoint's base class and the Minz statics to the stubs instead of the real
			# framework classes in ../FreshRSS, which then reports every inherited method as
			# undefined. Production code must be analysed against the real framework.
			- tests/stubs/
	checkBenevolentUnionTypes: true
	checkMissingOverrideMethodAttribute: true
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	reportAnyTypeWideningInVarTag: true
	treatPhpDocTypesAsCertain: false
	strictRules:
		disallowedEmpty: false
		disallowedLooseComparison: false
		disallowedShortTernary: false
	exceptions:
		check:
			missingCheckedExceptionInThrows: false	# TODO: Pass
			tooWideThrowType: true
		implicitThrows: false
		checkedExceptionClasses:
			- 'Minz_Exception'
includes:
	- vendor/phpstan/phpstan-strict-rules/rules.neon